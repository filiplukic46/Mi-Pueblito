---
// A print: the B&W base photo plus a color copy that the lens reveals (motion/develop.ts).
// `mobile` swaps in a phone crop (portrait) for screens up to 860px, for both copies.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  src: ImageMetadata; alt: string; label?: string; sizes: string; mobile?: ImageMetadata;
  eager?: boolean; class?: string; kind?: 'food' | 'room' | 'stage' | 'none'; widths?: number[]; quality?: number; attrs?: Record<string, string>;
}
const { src, alt, label, sizes, mobile, eager = false, class: cls = '', kind = 'room', widths = [480, 800, 1200, 1800], quality = 74, attrs = {} } = Astro.props;
const img = await getImage({ src, widths: widths.filter((w) => w <= src.width), format: 'webp', quality });
const mob = mobile ? await getImage({ src: mobile, widths: [560, 780], format: 'webp', quality: 52 }) : null;
const shared = { src: img.src, srcset: img.srcSet.attribute, sizes, width: src.width, height: src.height, decoding: 'async' as const };
const media = '(max-width: 860px)';
---
<figure class={`print ${cls}`} data-develop={kind === 'none' ? undefined : kind} {...attrs}>
  <picture>
    {mob && <source media={media} srcset={mob.srcSet.attribute} sizes="100vw" width={mobile!.width} height={mobile!.height} />}
    <img class="print__base" {...shared} alt={alt} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} data-critical={eager ? '' : undefined} />
  </picture>
  <picture>
    {mob && <source media={media} srcset={mob.srcSet.attribute} sizes="100vw" width={mobile!.width} height={mobile!.height} />}
    <img class="print__color" {...shared} alt="" aria-hidden="true" loading={eager ? 'eager' : 'lazy'} />
  </picture>
  <span class="print__ring" aria-hidden="true"></span>
  {label && <figcaption class="print__label">{label}</figcaption>}
</figure>
